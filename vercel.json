{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/frontend/admin/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/frontend/admin/$1"
    },
    {
      "source": "/((?!frontend|api|uploads).*)",
      "destination": "/frontend/$1"
    }
  ]
}
