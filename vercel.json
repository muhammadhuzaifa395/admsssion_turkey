{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/admin/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/admin/images/(.*)",
      "destination": "/frontend/images/$1"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/frontend/admin/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/frontend/admin/$1"
    },
    {
      "source": "/((?!frontend|api|uploads).*)",
      "destination": "/frontend/$1"
    }
  ]
}
